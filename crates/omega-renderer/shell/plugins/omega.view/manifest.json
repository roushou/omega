{
  "schemaVersion": 1,
  "id": "omega.view",
  "name": "Omega View",
  "version": "0.2.0",
  "author": "Omega",
  "description": "Renders a declarative view tree published by an Omega unit",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omega View",
    "description": "Renders the view tree an Omega plugin publishes for a surface",
    "category": "System",
    "allowMultiple": true,
    "defaultSection": "center",
    "defaults": {
      "unit": "",
      "surface": "",
      "panel": ""
    },
    "schema": [
      {
        "key": "unit",
        "type": "string",
        "label": "Plugin (empty = whichever is publishing)"
      },
      {
        "key": "surface",
        "type": "string",
        "label": "Surface (empty = whichever is publishing)"
      },
      {
        "key": "module",
        "type": "string",
        "label": "Instance (empty = the single one)"
      },
      {
        "key": "panel",
        "type": "string",
        "label": "Panel surface (empty = no popout)"
      },
      {
        "key": "socket",
        "type": "string",
        "label": "Shell socket path (empty = default)"
      }
    ]
  }
}
